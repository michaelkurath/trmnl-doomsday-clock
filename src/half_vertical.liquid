<div class="layout layout--top ds-layout ds-half-v">
  <header>
    <div class="ds-kicker">Global risk indicator · {{ current.year }}</div>
    <div class="ds-rule" style="margin-top: 9px"></div>
  </header>

  <section class="ds-clock-card" aria-label="Doomsday Clock face">
    <img class="ds-clock" src="data:image/svg+xml;base64,{{ clock_svg | base64_encode }}" alt="Clock hand near midnight">
  </section>

  <section>
    <div class="ds-half-v__hero">
      <span class="ds-number">{{ current.seconds_to_midnight }}</span>
      <span class="ds-unit">seconds<br>to midnight</span>
    </div>
    <div class="ds-time">
      <span class="ds-time-label">Clock position</span>
      <span class="ds-time-value">{{ hh2 }}:{{ mm2 }}:{{ ss2 }}</span>
    </div>
  </section>
</div>

<div class="title_bar">
  <span class="ds-title-icon">{{ title_icon }}</span>
  <span class="title">Doomsday Clock</span>
  <span class="instance">Updated {{ current.year }}</span>
</div>
