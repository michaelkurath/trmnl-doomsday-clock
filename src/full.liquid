<div class="layout layout--col ds-layout ds-full">
  <header class="ds-full__head">
    <span class="ds-kicker">Global risk indicator</span>
    <span class="ds-rule"></span>
    <span class="ds-kicker">{{ current.year }}</span>
  </header>

  <main class="ds-full__body">
    <section class="ds-clock-card" aria-label="Doomsday Clock face">
      <img class="ds-clock" src="data:image/svg+xml;base64,{{ clock_svg | base64_encode }}" alt="Clock hand near midnight">
    </section>

    <section class="ds-full__readout">
      <div class="ds-full__hero">
        <span class="ds-number">{{ current.seconds_to_midnight }}</span>
        <span class="ds-unit">seconds<br>to midnight</span>
      </div>

      <div class="ds-time">
        <span class="ds-time-label">Clock position</span>
        <span class="ds-time-value">{{ hh2 }}:{{ mm2 }}:{{ ss2 }}</span>
      </div>

      <div>
        <div class="ds-history-head">
          <span class="ds-history-title">Closer to midnight</span>
          <span class="ds-source">Recent settings · seconds remaining</span>
        </div>
        <div class="ds-history">
          {% for point in modern %}
            {% if point.year >= 2018 %}
              {% assign danger = 180 | minus: point.seconds %}
              {% if danger < 0 %}{% assign danger = 0 %}{% endif %}
              {% assign bar_height = danger | times: 52 | divided_by: 100 | plus: 12 %}
              {% if bar_height > 64 %}{% assign bar_height = 64 %}{% endif %}
              <div class="ds-history-item">
                <div class="ds-bar" style="height: {{ bar_height }}px"></div>
                <span class="ds-year">{{ point.year }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  </main>
</div>

<div class="title_bar">
  <span class="ds-title-icon">{{ title_icon }}</span>
  <span class="title">Doomsday Clock</span>
  <span class="instance">Bulletin of the Atomic Scientists · {{ current.year }}</span>
</div>
