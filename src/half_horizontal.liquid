<div class="layout layout--top">
  <!-- Content area takes remaining height; title bar sits at bottom -->
  <div class="columns">
    <!-- Analog -->
    <div class="column">


      {% assign s = current.seconds_to_midnight %}
      {% if s > 3600 %}{% assign s = 3600 %}{% endif %}
      {% if s < 0 %}{% assign s = 0 %}{% endif %}

        {% assign progress = 3600 | minus: s %}
        {% assign angle = progress | times: 360.0 | divided_by: 3600.0 %}

        {% capture clock_svg %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="-80 -80 160 160">
          <!-- Outer ring -->
          <circle cx="0" cy="0" r="75" fill="none" stroke="black" stroke-width="5"/>

          <!-- Dots for 5-minute marks (12 dots) -->
          {% for i in (0..11) %}
          {% assign deg = i | times: 30 %}
          <g transform="rotate({{ deg }})">
            <!-- place a small dot near the rim -->
            <circle cx="0" cy="-65" r="4" fill="black"/>
          </g>
          {% endfor %}

          <!-- Center cap -->
          <circle cx="0" cy="0" r="5" fill="black"/>

          <!-- Hand -->
          <g transform="rotate({{ angle }})">
            <line x1="0" y1="10" x2="0" y2="-60" stroke="black" stroke-width="5" stroke-linecap="round"/>
          </g>
        </svg>
        {% endcapture %}


        <img class="image" src="data:image/svg+xml;base64,{{ clock_svg | base64_encode }}" />
    </div>

    <!-- Digital -->
    <div class="column">


      <div class="text--center value value outline">{{ hh2 }}:{{ mm2 }}:{{ ss2 }}</div>
      <div class="text--center value value outline ">{{ current.seconds_to_midnight }} seconds to midnight</div>


    </div>

  </div>
</div>



